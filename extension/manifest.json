{
  "manifest_version": 3,
  "name": "Mozhi · Tanglish comment insights",
  "version": "1.0.0",
  "description": "Analyze loaded YouTube comments using your local Tamil-English NLP classifier. Research predictions, not abuse severity.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {"default_popup": "popup.html", "default_title": "Mozhi · Analyze loaded comments"},
  "background": {"service_worker": "background.js"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
